# Скопируйте этот файл в .env и укажите свои значения (файл .env игнорируется Git).

# --- Контейнер и рабочее окружение ---
CONTAINER_NAME=vscode-devbox
WORKSPACE_PATH=./workspace
TZ=UTC

# --- SSH-доступ ---
SSH_BIND_IP=127.0.0.1
SSH_PORT=2222
# Публичный SSH-ключ (например, из ~/.ssh/id_ed25519.pub). Добавляется в /home/dev/.ssh/authorized_keys при старте.
SSH_PUBLIC_KEY=

# --- Автонастройка Git внутри контейнера (/home/dev/.gitconfig) ---
GIT_USER_NAME=
GIT_USER_EMAIL=

# --- DNS и селективный прокси (dnsmasq + ipset + redsocks + iptables) ---
UPSTREAM_DNS=1.1.1.1
PROXY_ENABLED=true
# Хост/IP и порт прокси для redsocks (если SOCKS_PROXY_HOST пустой или PROXY_ENABLED=false, прокси пропускается)
SOCKS_PROXY_HOST=
SOCKS_PROXY_PORT=10808
SOCKS_PROXY_TYPE=socks5
# Дополнительные домены для проксирования через запятую (например: npmjs.org,nuget.org)
PROXY_EXTRA_DOMAINS=
