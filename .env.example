# Скопируйте этот файл в .env и укажите свои значения (файл .env игнорируется Git).
# Если переменные DNS или прокси оставить пустыми, контейнер будет читать настройки напрямую из smartdns.conf и redsocks.conf.

# --- Контейнер и рабочее окружение ---
# Для запуска готового образа из GHCR укажите, например: ghcr.io/<owner>/<repo>:v1.0.0
# DEVBOX_IMAGE=vscode-devbox
CONTAINER_NAME=vscode-devbox
WORKSPACE_PATH=./workspace
TZ=UTC

# --- SSH-доступ ---
SSH_BIND_IP=127.0.0.1
SSH_PORT=2222
# Публичный SSH-ключ (например, из ~/.ssh/id_ed25519.pub). Добавляется в /home/dev/.ssh/authorized_keys при старте.
SSH_PUBLIC_KEY=

# --- Автонастройка Git внутри контейнера (/home/dev/.gitconfig) ---
GIT_USER_NAME=
GIT_USER_EMAIL=

# --- DNS и DoH/DoT (SmartDNS) ---
# Если оба поля (UPSTREAM_DNS и DNS_ENCRYPTED_SERVERS) пустые, SmartDNS берёт апстримы из smartdns.conf.
# Обычный DNS-сервер (IP; также передаётся в dns: docker-compose и служит bootstrap-dns при использовании DoH/DoT)
UPSTREAM_DNS=
# DoH / DoT серверы через запятую (пример: https://dns.google/dns-query,tls://1.1.1.1:853)
DNS_ENCRYPTED_SERVERS=
# Отправлять ли DoH/DoT-запросы SmartDNS через SOCKS5 из настроек redsocks (true/false)
DNS_ENCRYPTED_VIA_SOCKS=false
# Включить локальный DNS-кэш SmartDNS (true/false; при false каждый DNS-запрос идёт на апстрим без кэширования)
DNS_CACHE_ENABLED=true
# Единое время жизни (сек) для записей DNS-кэша SmartDNS и записей ipset special_proxy (при DNS_CACHE_ENABLED=false задаёт только TTL ipset)
DNS_CACHE_TTL=300
# Принудительно заворачивать сторонний DNS (UDP/TCP 53) в SmartDNS и блокировать обход через внешний DoT (853) / публичные DoH (true/false)
DNS_FORCE_REDIRECT=true
# Дополнительные домены для ipset special_proxy через запятую (пример: npmjs.org,nuget.org)
PROXY_EXTRA_DOMAINS=

# --- Селективный прокси (redsocks + iptables) ---
# Режим fail-closed: при PROXY_ENABLED=true обязательно должен быть задан SOCKS_PROXY_HOST (или ip в redsocks.conf),
# иначе контейнер завершится с ошибкой при старте. Для работы напрямую без прокси выставьте PROXY_ENABLED=false.
PROXY_ENABLED=true
# Если SOCKS_PROXY_HOST пустой, читается адрес из redsocks.conf (кроме плейсхолдера 127.0.0.1)
SOCKS_PROXY_HOST=
SOCKS_PROXY_PORT=10808
SOCKS_PROXY_TYPE=socks5
